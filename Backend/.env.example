PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/rms
JWT_SECRET=your_jwt_secret_here

# Email Configuration (Nodemailer + Gmail SMTP)
# For Gmail, you must use an "App Password", NOT your regular password.
# See DEPLOYMENT.md for instructions on how to generate one.
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM="RMS Support" <your_email@gmail.com>
CONTACT_RECEIVER_EMAIL=admin_email@domain.com
